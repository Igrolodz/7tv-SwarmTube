{
    "manifest_version": 3,
    "name": "SwarmTube",
    "version": "1.0",
    "description": "Extension applying 7TV emotes to youtube comment section",
    "icons": {
        "16": "images/NurIcon.png",
        "32": "images/NurIcon.png",
        "64": "images/NurIcon.png",
        "128": "images/NurIcon.png"
    },
    "content_scripts": [
        {
            "matches": ["https://*.youtube.com/*"],
            "js": ["src/scripts/content.js"]
        }
    ],
    "action": {
        "default_popup": "src/templates/popup.html"
    },
    "permissions": ["storage", "identity"],
    "host_permissions": [
        "https://api.twitch.tv/*",
        "https://id.twitch.tv/*"
    ],
    "background": {
        "service_worker": "src/scripts/background.js"
    }
}